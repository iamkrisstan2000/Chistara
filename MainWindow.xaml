<Window x:Class="Chistara.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Chistara"
        xmlns:controls="clr-namespace:Chistara.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Chistara" Width="1128" Height="796" MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="False" Background="Transparent" Icon="Assets/Chistara.ico"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <local:ArtworkPathConverter x:Key="ArtworkPathConverter"/>

        <!-- Border.CornerRadius does not geometrically clip child images in WPF.
             These explicit clips keep every music cover and station poster truly circular. -->
        <Style x:Key="CircularArtworkImageStyle" TargetType="Image">
            <Setter Property="Stretch" Value="UniformToFill"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        </Style>
        <Style x:Key="CircularArtwork34Style" TargetType="Image" BasedOn="{StaticResource CircularArtworkImageStyle}">
            <Setter Property="Clip"><Setter.Value><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17"/></Setter.Value></Setter>
        </Style>
        <Style x:Key="CircularArtwork38Style" TargetType="Image" BasedOn="{StaticResource CircularArtworkImageStyle}">
            <Setter Property="Clip"><Setter.Value><EllipseGeometry Center="19,19" RadiusX="19" RadiusY="19"/></Setter.Value></Setter>
        </Style>
        <Style x:Key="CircularArtwork46Style" TargetType="Image" BasedOn="{StaticResource CircularArtworkImageStyle}">
            <Setter Property="Clip"><Setter.Value><EllipseGeometry Center="23,23" RadiusX="23" RadiusY="23"/></Setter.Value></Setter>
        </Style>
        <Style x:Key="CircularArtwork64Style" TargetType="Image" BasedOn="{StaticResource CircularArtworkImageStyle}">
            <Setter Property="Clip"><Setter.Value><EllipseGeometry Center="32,32" RadiusX="32" RadiusY="32"/></Setter.Value></Setter>
        </Style>
        <Style x:Key="CircularArtwork68Style" TargetType="Image" BasedOn="{StaticResource CircularArtworkImageStyle}">
            <Setter Property="Clip"><Setter.Value><EllipseGeometry Center="34,34" RadiusX="34" RadiusY="34"/></Setter.Value></Setter>
        </Style>

        <Style x:Key="ChoiceButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentButtonStyle}">
            <Setter Property="MinWidth" Value="92"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="selected">
                    <Setter Property="Background" Value="{DynamicResource AccentLowBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SwatchButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentButtonStyle}">
            <Setter Property="Width" Value="104"/>
            <Setter Property="Height" Value="62"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="selected"><Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Background" Value="{DynamicResource AccentLowBrush}"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TransportPlayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{DynamicResource TransportPlayBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TransportPlayForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Circle" Fill="{TemplateBinding Background}" Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Circle" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransportModeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ModeFill" Margin="2" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeFill" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/><Setter TargetName="ModeFill" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ModeFill" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="Tag" Value="active"><Setter TargetName="ModeFill" Property="Background" Value="{DynamicResource AccentLowBrush}"/><Setter TargetName="ModeFill" Property="BorderBrush" Value="{DynamicResource AccentMediumBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ModeFill" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RepeatOptionButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentButtonStyle}">
            <Setter Property="Width" Value="138"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="selected"><Setter Property="Background" Value="{DynamicResource AccentLowBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SortIconButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentButtonStyle}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="selected"><Setter Property="Background" Value="{DynamicResource AccentLowBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SortOptionButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentButtonStyle}">
            <Setter Property="Width" Value="176"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="selected"><Setter Property="Background" Value="{DynamicResource AccentLowBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopSettingsStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SettingsFill" Margin="1" CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SettingsFill" Property="Background" Value="{DynamicResource AccentLowBrush}"/><Setter TargetName="SettingsFill" Property="BorderBrush" Value="{DynamicResource AccentMediumBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="SettingsFill" Property="Background" Value="{DynamicResource AccentMediumBrush}"/><Setter TargetName="SettingsFill" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchResultItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Focusable" Value="True"/>
        </Style>

        <Style x:Key="SongListItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Focusable" Value="True"/>
        </Style>

        <Style x:Key="RecentCardItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Width" Value="256"/>
            <Setter Property="Height" Value="196"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <Style x:Key="TopSearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentMediumBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SearchResultTemplate">
            <Button Style="{StaticResource FluentButtonStyle}" Background="Transparent" BorderBrush="Transparent" Padding="8,5" HorizontalContentAlignment="Stretch"
                    CommandParameter="{Binding}" Click="SearchResult_Click">
                <Grid Height="46">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentLowBrush}" VerticalAlignment="Center" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource IconFont}" Foreground="{DynamicResource AccentBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding ArtworkSource, Converter={StaticResource ArtworkPathConverter}}" Style="{StaticResource CircularArtwork34Style}"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="7,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource ChipStyle}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Kind}" Style="{StaticResource MutedTextStyle}" FontSize="10"/>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SongTemplate">
            <!-- Compact columns reserve substantially more width for the title while
                 retaining direct play, circular artwork, subtitle, and duration. -->
            <Grid Height="54" Margin="1,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*" MinWidth="112"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Width="27" Height="27" FontSize="13" Content="&#xE768;" ToolTip="Play this song" CommandParameter="{Binding}" Click="TrackPlayButton_Click"/>
                <Border Grid.Column="1" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentMediumBrush}" VerticalAlignment="Center" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding ArtworkPath, Converter={StaticResource ArtworkPathConverter}}" Style="{StaticResource CircularArtwork34Style}"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,4,0" ToolTip="{Binding DisplayTitle}">
                    <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource BodyTextStyle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ListSubtitle}" Style="{StaticResource MutedTextStyle}" FontSize="9.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding DurationText}" Style="{StaticResource MutedTextStyle}" FontSize="9.5" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,3,0"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RecentTemplate">
            <Border Style="{StaticResource CardStyle}" Padding="12" Margin="2">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource AccentMediumBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding ArtworkPath, Converter={StaticResource ArtworkPathConverter}}" Style="{StaticResource CircularArtwork46Style}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource ChipStyle}" VerticalAlignment="Top" Padding="7,3">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding KindIcon}" FontFamily="{DynamicResource IconFont}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,5,0"/><TextBlock Text="{Binding KindText}" Style="{StaticResource MutedTextStyle}" FontSize="9"/></StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="1,7,1,3">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="38"/>
                        <TextBlock Text="{Binding DisplayArtist}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" MaxHeight="32" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <TextBlock Text="{Binding PlayedText}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Content="&#xE768;" ToolTip="Play again" CommandParameter="{Binding}" Click="RecentPlayButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DeviceTemplate">
            <Button Style="{StaticResource FluentButtonStyle}" Width="252" Height="112" Margin="0,0,10,10" Padding="14" HorizontalContentAlignment="Stretch"
                    CommandParameter="{Binding}" Click="DeviceCard_Click" ToolTip="Open this drive's music">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="9" Background="{DynamicResource AccentLowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                        <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xEDA2;" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Type}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding CapacityText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="GroupTemplate">
            <Button Style="{StaticResource FluentButtonStyle}" Height="160" Padding="11" Margin="0,0,8,8"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    CommandParameter="{Binding}" Click="GroupCard_Click" ToolTip="{Binding Name}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <!-- Clip the entire artwork composition—not only the Image—to an
                         exact circle. This also rounds the offset highlight instead of
                         letting its right edge meet the old rectangular layout bounds. -->
                    <Grid Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.Clip>
                            <EllipseGeometry Center="32,32" RadiusX="32" RadiusY="32"/>
                        </Grid.Clip>
                        <Ellipse Fill="{DynamicResource AccentMediumBrush}"/>
                        <Ellipse Width="42" Height="42" Fill="#28FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-9,-7,0"/>
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding ArtworkPath, Converter={StaticResource ArtworkPathConverter}}" Style="{StaticResource CircularArtwork64Style}"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="1,7,1,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}" Height="30" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="15"/>
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="HomeStationRecommendationTemplate">
            <Button Style="{StaticResource FluentButtonStyle}" Height="74" Margin="0,0,0,8" Padding="10" HorizontalContentAlignment="Stretch" CommandParameter="{Binding}" Click="HomeStationRecommendation_Click">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource AccentMediumBrush}" ClipToBounds="True" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding Favicon, Converter={StaticResource ArtworkPathConverter}}" Style="{StaticResource CircularArtwork38Style}"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="7,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding LocationText}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding TagsText}" Style="{StaticResource MutedTextStyle}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" FontFamily="{DynamicResource IconFont}" Text="&#xE768;" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="StationTemplate">
            <!-- Match All Songs: play action, compact circular art, then a title-first
                 text region that receives all remaining horizontal space. -->
            <Grid Height="54" Margin="1,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*" MinWidth="150"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Width="27" Height="27" FontSize="13" Content="&#xE768;" ToolTip="Play station" CommandParameter="{Binding}" Click="StationPlayButton_Click"/>
                <Border Grid.Column="1" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentMediumBrush}" VerticalAlignment="Center" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding Favicon, Converter={StaticResource ArtworkPathConverter}}" Style="{StaticResource CircularArtwork34Style}"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,4,0" ToolTip="{Binding Name}">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ListSubtitle}" Style="{StaticResource MutedTextStyle}" FontSize="9.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <!-- Custom Windows 11 title bar -->
        <Border Grid.Row="0" Background="{DynamicResource TopBarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/Chistara.png" Width="17" Height="17" Margin="0,0,8,0"/>
                    <TextBlock Text="Chistara" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="  •  Music &amp; radio" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="Minimize"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;" Click="MaximizeButton_Click" ToolTip="Maximize"/>
                    <Button Style="{StaticResource CloseCaptionButtonStyle}" Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Fluent tab strip, unified search, and independent Settings action. -->
        <Border Grid.Row="1" Background="{DynamicResource TopBarBrush}" BorderThickness="0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*" MaxWidth="644"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <ToggleButton x:Name="HomeTab" Width="72" Content="Home" Tag="Home" Style="{StaticResource TopNavStyle}" Click="TopTab_Click"/>
                    <ToggleButton x:Name="MusicTab" Width="72" Content="Music" Tag="Music" Style="{StaticResource TopNavStyle}" Click="TopTab_Click"/>
                    <ToggleButton x:Name="FMTab" Width="58" Content="FM" Tag="FM" Style="{StaticResource TopNavStyle}" Click="TopTab_Click"/>
                </StackPanel>

                <Border x:Name="GlobalSearchShell" Grid.Column="1" Height="30" MinWidth="240" MaxWidth="620" Margin="12,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        CornerRadius="6" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=GlobalSearchBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                        <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE721;" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="GlobalSearchBox" Style="{StaticResource TopSearchTextBoxStyle}" TextChanged="GlobalSearchBox_TextChanged" PreviewKeyDown="GlobalSearchBox_PreviewKeyDown" ToolTip="Search songs, artists, albums, or FM stations"/>
                            <TextBlock x:Name="GlobalSearchHint" Text="Search music and FM radio" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <Button x:Name="ClearSearchButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Content="&#xE711;" ToolTip="Clear search" Visibility="Collapsed" Click="ClearSearchButton_Click"/>
                    </Grid>
                </Border>

                <Border x:Name="HeaderStatusPill" Grid.Column="2" Style="{StaticResource ChipStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,48,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="HeaderStatusText" Text="Scanning…" Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                </Border>

                <ToggleButton x:Name="SettingsTab" Grid.Column="2" Content="&#xE713;" Tag="Settings" Style="{StaticResource TopSettingsStyle}" Click="TopTab_Click" ToolTip="Settings" HorizontalAlignment="Right"/>

                <Popup x:Name="GlobalSearchPopup" Grid.Column="1" PlacementTarget="{Binding ElementName=GlobalSearchShell}" Placement="Bottom" VerticalOffset="5"
                       AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                    <Border x:Name="SearchPopupBorder" Width="560" MaxHeight="430" Background="{DynamicResource SurfaceStrongBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="9" Effect="{StaticResource CardShadow}">
                        <Grid Margin="5">
                            <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Search results" Style="{StaticResource SecondaryTextStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SearchSummaryText" Grid.Column="1" Text="Music + FM" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <ListBox x:Name="SearchResultsList" ItemsSource="{Binding SearchResults}" ItemTemplate="{StaticResource SearchResultTemplate}" ItemContainerStyle="{StaticResource SearchResultItemStyle}" MaxHeight="350" PreviewKeyDown="SearchResultsList_PreviewKeyDown"/>
                                <StackPanel x:Name="SearchEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18">
                                    <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE721;" Foreground="{DynamicResource TextMutedBrush}" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No matching music or stations" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,7,8,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SearchFooterText" Text="Tip: try artist:, album:, song:, or fm:" Style="{StaticResource MutedTextStyle}" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="Enter to open  ·  Esc to clear" Style="{StaticResource MutedTextStyle}" FontSize="10"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Background="{DynamicResource WindowLayerBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- Contextual, collapsible navigation pane -->
            <Border x:Name="SidePane" Grid.Column="0" Width="224" Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE700;" Click="PaneToggleButton_Click" ToolTip="Collapse navigation" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PaneTitleText" Grid.Column="1" Text="Home" Style="{StaticResource SecondaryTextStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding PaneItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource PaneButtonStyle}" IsChecked="{Binding IsSelected, Mode=TwoWay}" CommandParameter="{Binding Id}" Click="PaneItem_Click" ToolTip="{Binding Label}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource IconFont}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Page content -->
            <Grid Grid.Column="1" ClipToBounds="True">
                <!-- HOME -->
                <Grid x:Name="HomePage" Margin="28,22,6,18">
                    <ScrollViewer x:Name="HomeOverviewView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <StackPanel Margin="0,0,30,12">
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="HomeGreetingText" Text="Welcome back to your sound" Style="{StaticResource PageTitleStyle}"/>
                                    <TextBlock Text="Your music and live radio, in one calm place." Style="{StaticResource SecondaryTextStyle}" Margin="1,5,0,0" FontSize="13"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Padding="17,9" Click="PlaySomethingButton_Click" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE768;" Margin="0,0,8,0"/><TextBlock Text="Play something"/></StackPanel>
                                </Button>
                            </Grid>

                            <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,0,18">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{DynamicResource AccentHeroStartColor}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource AccentHeroMidColor}" Offset="0.55"/>
                                        <GradientStop Color="#10000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Height="112">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="YOUR SOUND, READY" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="HeroTitle" Text="Bring your library to life" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="HeroDescription" Text="Add a music folder or tune in to a live station." Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" Width="132" Margin="20,0,4,0">
                                        <Ellipse Width="108" Height="108" Fill="{DynamicResource AccentLowBrush}" HorizontalAlignment="Center"/>
                                        <Ellipse Width="86" Height="86" Fill="{DynamicResource AccentMediumBrush}" Opacity="0.55" HorizontalAlignment="Center"/>
                                        <Border x:Name="HomeHeroDisc" Width="70" Height="70" CornerRadius="35" Background="{DynamicResource AccentBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
                                            <Grid>
                                                <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE8D6;" Foreground="{DynamicResource AccentTextBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image x:Name="HomeHeroImage" Style="{StaticResource CircularArtwork68Style}"/>
                                                <Ellipse Width="10" Height="10" Fill="{DynamicResource PlaybackBrush}" Stroke="#66FFFFFF" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock Text="Start listening" Style="{StaticResource SectionTitleStyle}" Margin="1,0,0,10"/>
                            <WrapPanel>
                                <Button Style="{StaticResource FluentButtonStyle}" Width="224" Height="76" Margin="0,0,10,10" Padding="14" HorizontalContentAlignment="Stretch" Click="HomeOpenMusic_Click">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentLowBrush}"><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE8D6;" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="Music library" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/><TextBlock Text="Browse songs and devices" Style="{StaticResource MutedTextStyle}"/></StackPanel></Grid>
                                </Button>
                                <Button Style="{StaticResource FluentButtonStyle}" Width="224" Height="76" Margin="0,0,10,10" Padding="14" HorizontalContentAlignment="Stretch" Click="HomeOpenLocalFm_Click">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentLowBrush}"><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE720;" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="Local FM" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/><TextBlock Text="Tune in near you" Style="{StaticResource MutedTextStyle}"/></StackPanel></Grid>
                                </Button>
                            </WrapPanel>

                            <TextBlock Text="FM updates and recommendations" Style="{StaticResource SectionTitleStyle}" Margin="1,10,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14" MinHeight="284">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Local FM updates" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="HomeLocalRecommendationSubtitle" Text="Popular streams near you" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="1" Style="{StaticResource ChipStyle}" VerticalAlignment="Top"><TextBlock Text="NEAR YOU" Style="{StaticResource MutedTextStyle}" FontSize="9"/></Border></Grid>
                                        <Grid>
                                            <TextBlock x:Name="HomeLocalRecommendationStatus" Text="Finding local stations…" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" Margin="0,36,0,0"/>
                                            <ItemsControl ItemsSource="{Binding HomeLocalStations}" ItemTemplate="{StaticResource HomeStationRecommendationTemplate}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14" MinHeight="284">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Worldwide FM picks" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Fresh discoveries across the directory" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="1" Style="{StaticResource ChipStyle}" VerticalAlignment="Top"><TextBlock Text="WORLD" Style="{StaticResource MutedTextStyle}" FontSize="9"/></Border></Grid>
                                        <Grid>
                                            <TextBlock x:Name="HomeWorldwideRecommendationStatus" Text="Finding worldwide stations…" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" Margin="0,36,0,0"/>
                                            <ItemsControl ItemsSource="{Binding HomeWorldwideStations}" ItemTemplate="{StaticResource HomeStationRecommendationTemplate}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="HomeRecentView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Visibility="Collapsed">
                        <StackPanel Margin="0,0,30,12">
                            <TextBlock Text="Recently played" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="Your latest music and FM streams, up to 12 cards." Style="{StaticResource SecondaryTextStyle}" Margin="1,5,0,20" FontSize="13"/>
                            <Grid MinHeight="180">
                                <TextBlock x:Name="RecentEmptyText" Text="Nothing played yet. Choose a song or a live station to begin." Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ListBox x:Name="HomeRecentList" ItemsSource="{Binding RecentItems}" ItemTemplate="{StaticResource RecentTemplate}" ItemContainerStyle="{StaticResource RecentCardItemStyle}" MouseDoubleClick="HomeRecentList_MouseDoubleClick" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                </ListBox>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- MUSIC -->
                <Grid x:Name="MusicPage" Margin="28,22,6,18" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,22,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="MusicPageTitle" Text="All Songs" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock x:Name="MusicPageSubtitle" Text="Your complete music library." Style="{StaticResource SecondaryTextStyle}" Margin="1,5,0,0" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource FluentButtonStyle}" Click="RescanButton_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE72C;" Margin="0,0,7,0"/><TextBlock Text="Rescan"/></StackPanel></Button>
                            <Button x:Name="MusicSortButton" Style="{StaticResource SortIconButtonStyle}" Content="&#xE8CB;" ToolTip="Sort music" Click="MusicSortButton_Click"/>
                            <Popup x:Name="MusicSortPopup" PlacementTarget="{Binding ElementName=MusicSortButton}" Placement="Bottom" VerticalOffset="5" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource SurfaceStrongBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="5" Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <TextBlock Text="Sort music" Style="{StaticResource MutedTextStyle}" FontWeight="SemiBold" Margin="9,5,9,4"/>
                                        <Button x:Name="MusicSortAlphabeticalOption" Style="{StaticResource SortOptionButtonStyle}" CommandParameter="Alphabetical" Click="MusicSortOption_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE8CB;" Width="24"/><TextBlock Text="Alphabetical"/></StackPanel></Button>
                                        <Button x:Name="MusicSortRecentOption" Style="{StaticResource SortOptionButtonStyle}" CommandParameter="RecentlyPlayed" Click="MusicSortOption_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE823;" Width="24"/><TextBlock Text="Recently Played"/></StackPanel></Button>
                                        <Button x:Name="MusicSortDateAddedOption" Style="{StaticResource SortOptionButtonStyle}" CommandParameter="DateAdded" Click="MusicSortOption_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE787;" Width="24"/><TextBlock Text="Date Added"/></StackPanel></Button>
                                        <Button x:Name="MusicSortDateModifiedOption" Style="{StaticResource SortOptionButtonStyle}" CommandParameter="DateModified" Click="MusicSortOption_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE895;" Width="24"/><TextBlock Text="Date Modified"/></StackPanel></Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,14,22,12">
                        <TextBlock Text="Use the unified search above to find songs, artists, or albums." Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource ChipStyle}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="LibraryStatsText" Text="0 songs" Style="{StaticResource SecondaryTextStyle}"/>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,0,22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="MusicVisualizerColumn" Width="*" MinWidth="220"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition x:Name="MusicListColumn" Width="300" MinWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <controls:VisualizerPanel x:Name="MusicVisualizerPanel" Grid.Column="0"/>

                        <!-- The list sits directly on the page layer: no enclosing rounded card. -->
                        <Grid Grid.Column="2" Margin="0">
                                <Grid x:Name="MusicEmptyPanel">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300" Margin="16">
                                        <Border Width="54" Height="54" CornerRadius="27" Background="{DynamicResource AccentLowBrush}" Margin="0,0,0,14">
                                            <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE8D6;" Foreground="{DynamicResource AccentBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Your library is waiting" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Add your media folders from Settings › Player, then rescan the library." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16"/>
                                        <Button Style="{StaticResource AccentButtonStyle}" Content="Open Player settings" Click="OpenPlayerSettings_Click"/>
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="MusicSongList" ItemsSource="{Binding VisibleTracks}" ItemTemplate="{StaticResource SongTemplate}" ItemContainerStyle="{StaticResource SongListItemStyle}" MouseDoubleClick="MusicSongList_MouseDoubleClick" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="GroupScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding LibraryGroups}" ItemTemplate="{StaticResource GroupTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:AdaptiveUniformGrid MinimumItemWidth="158" MaximumColumns="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                                <ScrollViewer x:Name="MusicDevicesScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="Choose a drive to discover and play its music files." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                        <TextBlock x:Name="MusicDevicesEmptyText" Text="No ready local, removable, or network drives were found." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,12" Visibility="Collapsed"/>
                                        <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceTemplate}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- FM RADIO -->
                <Grid x:Name="RadioPage" Margin="28,22,6,18" Visibility="Collapsed">
                    <!-- Match All Songs vertically: header, helper row, then one
                         uninterrupted content row down to the player. -->
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,22,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="RadioPageTitle" Text="Local FM" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock x:Name="RadioPageSubtitle" Text="Internet radio stations from your Windows region." Style="{StaticResource SecondaryTextStyle}" Margin="1,5,0,0" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource FluentButtonStyle}" Click="RefreshRadioButton_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE72C;" Margin="0,0,7,0"/><TextBlock Text="Refresh stations"/></StackPanel>
                            </Button>
                            <Button x:Name="RadioSortButton" Style="{StaticResource SortIconButtonStyle}" Content="&#xE8CB;" ToolTip="Sort FM" Click="RadioSortButton_Click"/>
                            <Popup x:Name="RadioSortPopup" PlacementTarget="{Binding ElementName=RadioSortButton}" Placement="Bottom" VerticalOffset="5" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource SurfaceStrongBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="5" Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <TextBlock Text="Sort FM" Style="{StaticResource MutedTextStyle}" FontWeight="SemiBold" Margin="9,5,9,4"/>
                                        <Button x:Name="RadioSortAlphabeticalOption" Style="{StaticResource SortOptionButtonStyle}" CommandParameter="Alphabetical" Click="RadioSortOption_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE8CB;" Width="24"/><TextBlock Text="Alphabetical"/></StackPanel></Button>
                                        <Button x:Name="RadioSortRecentOption" Style="{StaticResource SortOptionButtonStyle}" CommandParameter="RecentlyPlayed" Click="RadioSortOption_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE823;" Width="24"/><TextBlock Text="Recently Played"/></StackPanel></Button>
                                        <Button x:Name="RadioSortDateAddedOption" Style="{StaticResource SortOptionButtonStyle}" CommandParameter="DateAdded" Click="RadioSortOption_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE787;" Width="24"/><TextBlock Text="Date Added"/></StackPanel></Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,14,22,12">
                        <TextBlock Text="Search station names, locations, languages, or genres from the top bar." Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource ChipStyle}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="RadioCountText" Text="Ready" Style="{StaticResource SecondaryTextStyle}"/>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,0,22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="220"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="300" MinWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <controls:VisualizerPanel x:Name="RadioVisualizerPanel" Grid.Column="0"/>

                        <!-- FM rows also sit directly on the page layer without a rounded list shell. -->
                        <Grid Grid.Column="2">
                                <StackPanel x:Name="RadioLoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="300" Margin="16">
                                    <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource AccentLowBrush}" Margin="0,0,0,12">
                                        <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE895;" Foreground="{DynamicResource AccentBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="RadioLoadingTitle" Text="Tuning the dial…" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    <TextBlock x:Name="RadioLoadingText" Text="Fetching healthy streams from Radio Browser" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="RadioEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300" Margin="16">
                                    <Border Width="54" Height="54" CornerRadius="27" Background="{DynamicResource AccentLowBrush}" Margin="0,0,0,14">
                                        <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE720;" Foreground="{DynamicResource AccentBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="RadioEmptyTitle" Text="Select Local or Worldwide FM" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    <TextBlock x:Name="RadioEmptyDescription" Text="An internet connection is used only to retrieve and play public station streams." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                                <ListBox x:Name="RadioStationList" ItemsSource="{Binding VisibleStations}" ItemTemplate="{StaticResource StationTemplate}" ItemContainerStyle="{StaticResource SongListItemStyle}" MouseDoubleClick="RadioStationList_MouseDoubleClick" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- SETTINGS -->
                <Grid x:Name="SettingsPage" Margin="28,22,6,18" Visibility="Collapsed">
                    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <StackPanel Margin="0,0,22,20">
                            <TextBlock x:Name="SettingsPageTitle" Text="Visual" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock x:Name="SettingsPageSubtitle" Text="Choose the appearance and accent used throughout Chistara." Style="{StaticResource SecondaryTextStyle}" Margin="1,5,0,20" FontSize="13"/>

                            <Border x:Name="ModesSection" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Modes" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="Follow Windows or choose an appearance." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,20,0"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button x:Name="ModeDarkButton" Content="Dark" CommandParameter="Dark" Style="{StaticResource ChoiceButtonStyle}" Margin="0,0,8,8" Click="ModeButton_Click"/>
                                        <Button x:Name="ModeLightButton" Content="Light" CommandParameter="Light" Style="{StaticResource ChoiceButtonStyle}" Margin="0,0,8,8" Click="ModeButton_Click"/>
                                        <Button x:Name="ModeSystemButton" Content="System" CommandParameter="System" Style="{StaticResource ChoiceButtonStyle}" Margin="0,0,8,8" Click="ModeButton_Click"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="AccentsSection" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Accents" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="Color for selections, controls and active states." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,20,0"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1">
                                        <Button x:Name="AccentSystem" Style="{StaticResource SwatchButtonStyle}" CommandParameter="System" Click="AccentButton_Click"><StackPanel><Ellipse Width="22" Height="22" Fill="{DynamicResource SystemAccentPreviewBrush}" HorizontalAlignment="Center"/><TextBlock Text="System" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Button>
                                        <Button x:Name="AccentRed" Style="{StaticResource SwatchButtonStyle}" CommandParameter="Red" Click="AccentButton_Click"><StackPanel><Ellipse Width="22" Height="22" Fill="#EB5B58" HorizontalAlignment="Center"/><TextBlock Text="Red" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Button>
                                        <Button x:Name="AccentPink" Style="{StaticResource SwatchButtonStyle}" CommandParameter="Pink" Click="AccentButton_Click"><StackPanel><Ellipse Width="22" Height="22" Fill="#EF69A4" HorizontalAlignment="Center"/><TextBlock Text="Pink" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Button>
                                        <Button x:Name="AccentMatcha" Style="{StaticResource SwatchButtonStyle}" CommandParameter="Matcha" Click="AccentButton_Click"><StackPanel><Ellipse Width="22" Height="22" Fill="#9BD36F" HorizontalAlignment="Center"/><TextBlock Text="Matcha" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Button>
                                        <Button x:Name="AccentPurple" Style="{StaticResource SwatchButtonStyle}" CommandParameter="Purple" Click="AccentButton_Click"><StackPanel><Ellipse Width="22" Height="22" Fill="#AA8BFA" HorizontalAlignment="Center"/><TextBlock Text="Purple" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Button>
                                        <Button x:Name="AccentCyan" Style="{StaticResource SwatchButtonStyle}" CommandParameter="Cyan" Click="AccentButton_Click"><StackPanel><Ellipse Width="22" Height="22" Fill="#45D2E4" HorizontalAlignment="Center"/><TextBlock Text="Cyan" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Button>
                                        <Button x:Name="AccentLime" Style="{StaticResource SwatchButtonStyle}" CommandParameter="Lime" Click="AccentButton_Click"><StackPanel><Ellipse Width="22" Height="22" Fill="#BEE24A" HorizontalAlignment="Center"/><TextBlock Text="Lime" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Button>
                                        <Button x:Name="AccentRgb" Style="{StaticResource SwatchButtonStyle}" CommandParameter="RGB gradient" Click="AccentButton_Click"><StackPanel><Ellipse Width="22" Height="22" HorizontalAlignment="Center"><Ellipse.Fill><LinearGradientBrush><GradientStop Color="#F45D79"/><GradientStop Color="#B279F6" Offset="0.34"/><GradientStop Color="#45D2E4" Offset="0.68"/><GradientStop Color="#BEE24A" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse><TextBlock Text="RGB" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Button>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="FoldersSection" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Default media folders" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="Folders Chistara scans. Your actual files are never changed." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,20,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <ItemsControl x:Name="MediaFolderList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,7">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE8B7;" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Content="&#xE74D;" ToolTip="Remove folder" CommandParameter="{Binding}" Click="RemoveFolderButton_Click"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Button Style="{StaticResource FluentButtonStyle}" Content="Add folder" Margin="0,0,8,0" Click="AddFolderButton_Click"/>
                                            <Button Style="{StaticResource FluentButtonStyle}" Content="Scan now" Click="RescanButton_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="SoundSection" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Sound enhancements" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Processed in real time for local playback." Style="{StaticResource MutedTextStyle}" Margin="0,5,0,15"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Equalizer" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/><TextBlock Text="Three-band, low-overhead EQ" Style="{StaticResource MutedTextStyle}"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0,20,0">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="Bass" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/><Slider x:Name="BassSlider" Grid.Column="1" Minimum="-12" Maximum="12" ValueChanged="EffectSlider_ValueChanged"/><TextBlock x:Name="BassValueText" Grid.Column="2" Text="0 dB" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="Mid" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/><Slider x:Name="MidSlider" Grid.Column="1" Minimum="-12" Maximum="12" ValueChanged="EffectSlider_ValueChanged"/><TextBlock x:Name="MidValueText" Grid.Column="2" Text="0 dB" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="Treble" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/><Slider x:Name="TrebleSlider" Grid.Column="1" Minimum="-12" Maximum="12" ValueChanged="EffectSlider_ValueChanged"/><TextBlock x:Name="TrebleValueText" Grid.Column="2" Text="0 dB" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                                        </StackPanel>
                                        <CheckBox x:Name="EqualizerToggle" Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" Checked="EffectToggle_Changed" Unchecked="EffectToggle_Changed" VerticalAlignment="Top"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,14"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Reverb" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/><TextBlock Text="A subtle room effect" Style="{StaticResource MutedTextStyle}"/></StackPanel>
                                        <Grid Grid.Column="1" Margin="12,0,20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Slider x:Name="ReverbSlider" Minimum="0" Maximum="0.6" ValueChanged="EffectSlider_ValueChanged"/><TextBlock x:Name="ReverbValueText" Grid.Column="1" Text="18%" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                                        <CheckBox x:Name="ReverbToggle" Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" Checked="EffectToggle_Changed" Unchecked="EffectToggle_Changed" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Crossfade" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/><TextBlock Text="Blend adjacent local songs" Style="{StaticResource MutedTextStyle}"/></StackPanel>
                                        <Grid Grid.Column="1" Margin="12,0,20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Slider x:Name="CrossfadeSlider" Minimum="0.5" Maximum="2" SmallChange="0.1" LargeChange="0.5" ValueChanged="EffectSlider_ValueChanged"/><TextBlock x:Name="CrossfadeValueText" Grid.Column="1" Text="1 s" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                                        <CheckBox x:Name="CrossfadeToggle" Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" Checked="EffectToggle_Changed" Unchecked="EffectToggle_Changed" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="StreamSection" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Stream settings" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Balance bandwidth and station quality." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,20,0"/></StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Stream quality preference" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="StreamQualityCombo" SelectionChanged="StreamQualityCombo_SelectionChanged" Width="220" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="Data saver"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="High"/>
                                        </ComboBox>
                                        <Button Style="{StaticResource FluentButtonStyle}" Content="Refresh FM stream list" HorizontalAlignment="Left" Margin="0,10,0,0" Click="RefreshRadioButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="TroubleshootSection" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Troubleshoot" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Recovery and performance options." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,20,0"/></StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Lite mode" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/><TextBlock Text="Caps large scans and uses a lower-cost Mica backdrop. Default: Off." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/></StackPanel><CheckBox x:Name="LiteModeToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" Checked="LiteModeToggle_Changed" Unchecked="LiteModeToggle_Changed" Margin="16,0,0,0"/></Grid>
                                        <Button Style="{StaticResource FluentButtonStyle}" Content="Restore all settings to defaults" HorizontalAlignment="Left" Foreground="{DynamicResource DangerBrush}" Click="ResetSettingsButton_Click"/>
                                        <TextBlock Text="This clears Chistara preferences and caches only. Music files are never deleted." Style="{StaticResource MutedTextStyle}" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="AboutSection" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="About" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Application and privacy information." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,20,0"/></StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Image Source="Assets/Chistara.png" Width="54" Height="54" Margin="0,0,14,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Chistara 1.1.0" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Fluent music + worldwide FM for Windows 11" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0"/>
                                                <TextBlock Text="Private by design: no accounts, ads or telemetry." Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,14"/>
                                        <StackPanel>
                                            <TextBlock Text="Made by KnightWin" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                            <TextBlock Text="This tool was made possible by AI" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"/>
                                            <TextBlock Text="October 2026" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- In-app notification -->
                <Border x:Name="Toast" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18" Padding="12,9" CornerRadius="7" Background="{DynamicResource SurfaceStrongBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Visibility="Collapsed" MaxWidth="420">
                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="ToastIcon" FontFamily="{DynamicResource IconFont}" Text="&#xE946;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="ToastText" Text="Ready" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/></StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- One-sided top material shadow: fades only downward into content, never into the title bar. -->
        <Border Grid.Row="2" Panel.ZIndex="3" Height="6" VerticalAlignment="Top" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1C000000" Offset="0"/>
                    <GradientStop Color="#12000000" Offset="0.18"/>
                    <GradientStop Color="#0B000000" Offset="0.40"/>
                    <GradientStop Color="#04000000" Offset="0.68"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Persistent now-playing transport -->
        <Border Grid.Row="3" Panel.ZIndex="2" Background="{DynamicResource PlaybackBrush}" BorderThickness="0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="90" ShadowDepth="1" BlurRadius="6" Opacity="0.18" RenderingBias="Quality"/>
            </Border.Effect>
            <Grid Margin="14,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="NowAlbumTile" Width="46" Height="46" CornerRadius="23" Background="{DynamicResource AccentMediumBrush}" VerticalAlignment="Center" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="NowAlbumInitials" Text="♪" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="NowAlbumImage" Style="{StaticResource CircularArtwork46Style}"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NowTitleText" Text="Nothing playing" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="NowArtistText" Text="Choose music or FM radio" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="1" Margin="12,0">
                    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="ShuffleButton" Style="{StaticResource TransportModeButtonStyle}" Content="&#xE8B1;" ToolTip="Shuffle off" Click="ShuffleButton_Click" Visibility="Collapsed"/>
                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE892;" ToolTip="Previous" Click="PreviousButton_Click"/>
                            <Button x:Name="PlayPauseButton" Style="{StaticResource TransportPlayButtonStyle}" Margin="5,-2" ToolTip="Play or pause" Click="PlayPauseButton_Click"><TextBlock x:Name="PlayPauseText" FontFamily="{DynamicResource IconFont}" FontSize="14" Text="&#xE768;"/></Button>
                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE893;" ToolTip="Next" Click="NextButton_Click"/>
                            <Button x:Name="RepeatModeButton" Style="{StaticResource TransportModeButtonStyle}" ToolTip="Repeat options" Click="RepeatModeButton_Click" Visibility="Collapsed"><TextBlock x:Name="RepeatModeText" FontFamily="{DynamicResource IconFont}" Text="&#xE8EE;"/></Button>
                        </StackPanel>
                        <Popup x:Name="RepeatModePopup" PlacementTarget="{Binding ElementName=RepeatModeButton}" Placement="Top" VerticalOffset="-6" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource SurfaceStrongBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <Button x:Name="RepeatOffOption" Style="{StaticResource RepeatOptionButtonStyle}" CommandParameter="Off" Click="RepeatModeOption_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE8EE;" Width="22" Opacity="0.55"/><TextBlock Text="Repeat off"/></StackPanel></Button>
                                    <Button x:Name="RepeatAllOption" Style="{StaticResource RepeatOptionButtonStyle}" CommandParameter="All" Click="RepeatModeOption_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE8EE;" Width="22"/><TextBlock Text="Repeat all"/></StackPanel></Button>
                                    <Button x:Name="RepeatOneOption" Style="{StaticResource RepeatOptionButtonStyle}" CommandParameter="One" Click="RepeatModeOption_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE8ED;" Width="22"/><TextBlock Text="Repeat one"/></StackPanel></Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="CurrentTimeText" Text="0:00" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                        <Slider x:Name="PlaybackSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0" Margin="4,0" PreviewMouseLeftButtonDown="PlaybackSlider_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="PlaybackSlider_PreviewMouseLeftButtonUp"/>
                        <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="0:00" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                    <Button x:Name="MuteButton" Style="{StaticResource IconButtonStyle}" Content="&#xE995;" ToolTip="Mute" Click="MuteButton_Click"/>
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0.72" ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VolumeText" Grid.Column="2" Text="72%" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <MediaElement x:Name="RadioMedia" Width="0" Height="0" LoadedBehavior="Manual" UnloadedBehavior="Stop" ScrubbingEnabled="True" MediaOpened="RadioMedia_MediaOpened" MediaFailed="RadioMedia_MediaFailed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
